{
  "name": "agents-portal",
  "version": "0.1.0",
  "description": "Drive AI coding agents running in tmux from any device's browser, over Tailscale.",
  "type": "module",
  "bin": {
    "agents-portal": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "dev:hub": "tsx watch src/cli/index.ts hub --dev",
    "dev:agent": "tsx watch src/cli/index.ts up --dev",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@xterm/addon-unicode11": "^0.9.0",
    "commander": "^12.1.0",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
